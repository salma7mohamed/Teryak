# ====================================================================
# منصة ترياق الطبية - دليل المتغيرات البيئية (Environment Variables)
# جميع الخدمات المختارة هنا مجانية بنسبة 100% مدى الحياة (Free Tier)
# ====================================================================

# --------------------------------------------------------------------
# 1. إعدادات الخادم والبيئة (Server Configuration)
# --------------------------------------------------------------------
# بيئة التشغيل: development للتطوير المحلي أو production للإنتاج
NODE_ENV=development

# منفذ تشغيل الخادم (الافتراضي: 5000)
PORT=5000

# --------------------------------------------------------------------
# 2. رابط قاعدة البيانات (MongoDB Connection URI - مجاني من MongoDB Atlas)
# --------------------------------------------------------------------
# خطة مجانية مدى الحياة (M0 Sandbox 512MB) على https://cloud.mongodb.com
# استبدل <username> و <password> ببيانات المستخدم الذي أنشأته في Database Access
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/teryak_db?retryWrites=true&w=majority&appName=Teryak

# رابط محلي بديل في حال تشغيل MongoDB محلياً على جهازك:
# MONGODB_URI=mongodb://127.0.0.1:27017/teryak_db

# --------------------------------------------------------------------
# 3. التوثيق وتشفير رموز الدخول (JWT Authentication Secrets - مجاني)
# --------------------------------------------------------------------
# مفتاح سري عشوائي طويل لتشفير توكن المستخدمين
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# مدة صلاحية الجلسة قبل طلب تسجيل الدخول مجدداً
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------------
# 4. النطاقات المسموح لها بالاتصال (CORS Allowed Origins)
# --------------------------------------------------------------------
# العناوين المسموح لها بإرسال طلبات للـ API
CLIENT_URL=http://localhost:5000,http://127.0.0.1:5500,http://localhost:3000

# --------------------------------------------------------------------
# 5. خدمة رفع وتخزين الصور والمستندات (Cloudinary - خطة مجانية 25GB)
# --------------------------------------------------------------------
# اختياري: إذا تركت هذه الحقول فارغة، سيعمل النظام تلقائياً بنظام Base64 المجاني
# للحصول على المفاتيح مجاناً: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
